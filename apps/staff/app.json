{
  "expo": {
    "name": "Shiv Staff",
    "slug": "shiv-staff",
    "scheme": "shivstaff",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["android", "web"],
    "android": {
      "package": "in.shivcement.staff",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F3F1EA"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Shiv Staff"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F1EA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Shiv Staff uses the camera to scan the shop's QR for hazri, and for photos you choose to take.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shiv Staff reads your location only while the hazri screen is open and at driver taps.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Release builds print no debug, verbose or info lines.\n-assumenosideeffects class android.util.Log {\n public static int v(...);\n public static int d(...);\n public static int i(...);\n}\n"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#F3F1EA"
  }
}
