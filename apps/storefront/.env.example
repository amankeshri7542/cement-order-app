# Customer storefront. These values are compiled into the public bundle: never put secrets here.
# Local development (the launcher sets this automatically).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production builds refuse a non-HTTPS API or asset origin at request time.
# NEXT_PUBLIC_API_URL=https://api.staging.example.com/api/v1
# Separate HTTPS origin for approved product photos, when configured.
# NEXT_PUBLIC_ASSET_ORIGIN=https://assets.staging.example.com
# Shows "Review note · not shown to customers" boxes in a production build for a private
# family review. Leave unset for any build customers can reach.
# NEXT_PUBLIC_CONTENT_REVIEW=on
# The customer app's Google Play address, shown in the footer once the app is published.
# NEXT_PUBLIC_PLAY_URL=https://play.google.com/store/apps/details?id=in.shivcement.store
# Server-side settings (not compiled into the public bundle):
# The website's own public address. Used for canonical links, the sitemap and structured data.
# SITE_URL=https://www.example.in
# Must match the API's REVALIDATE_SECRET, so a published rate shows on the next page load.
# REVALIDATE_SECRET=
# Seconds the website may reuse the shop's catalogue. 60 in production, 5 in development.
# CATALOG_TTL_SECONDS=60
# Search engines are kept out until this is "on" AND SITE_URL is https. Leave off for staging.
# SITE_INDEXING=off
# Named on the privacy page. Set this before the shop's WhatsApp is connected.
# NEXT_PUBLIC_WHATSAPP_PARTNER=
# "off" gives every visitor the still home page, with no film.
# NEXT_PUBLIC_FILM=on
