generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  CONTRACTOR
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERY_EXCEPTION
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  PENDING
  CAPTURED
  REFUND_PENDING
  REFUNDED
}

enum PaymentMethod {
  COD
  ONLINE
  CREDIT
}

enum OrderSource {
  APP
  WEB
  PHONE
  WALK_IN
  QUOTE
}

enum LedgerKind {
  SALE_ON_CREDIT
  PAYMENT_RECEIVED
  OPENING_BALANCE
  ADJUSTMENT
  REVERSAL
}

enum QuoteStatus {
  REQUESTED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  customerGroupId   String?
  customerGroup     CustomerGroup? @relation(fields: [customerGroupId], references: [id])
  /// How far below list this person may set a rate at confirm. Empty means the shop's limit.
  rateCapPercent    Int?
  // Set while an owner has paused this person. Their memberships stay, and give no access.
  staffPausedAt     DateTime?
  staffMemberships  StaffMembership[]     @relation("MemberUser")
  pushTokens        PushActionToken[]
  creditAllowed     Boolean               @default(false)
  creditLimitPaise  Int?
  khataBalancePaise Int                   @default(0)
  area              String                @default("")
  tags              String[]              @default([])
  lastOrderAt       DateTime?
  notesCount        Int                   @default(0)
  ledgerEntries     CustomerLedgerEntry[]
  customerNotes     CustomerNote[]
  customerContacts  CustomerContact[]
  demandOverrides   DemandOverride[]
  contractorStatus  String                @default("NONE")
  deletedAt         DateTime?
  adminCredential   AdminCredential?
  id                String                @id @default(cuid())
  phone             String                @unique
  name              String                @default("")
  role              Role                  @default(CUSTOMER)
  language          String                @default("en")
  staffTitle        String                @default("")
  whatsappAlerts    Boolean               @default(false)
  pushSubscriptions PushSubscription[]
  outboundMessages  OutboundMessage[]
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          Session[]
  addresses         Address[]
  cart              CartItem[]
  reviews           CheckoutReview[]
  orders            Order[]
  quotes            Quote[]
  notifications     Notification[]
  devices           Device[]
  assignedWork      OwnerWork[]           @relation("WorkOwner")
  technicalWork     OwnerWork[]           @relation("TechnicalOwner")

  @@index([createdAt, id])
}

model Session {
  // Where this session signed in. Staff rights apply only to desk sessions, so a token from
  // the customer app of someone who is also staff reaches nothing on the desk.
  surface              SessionSurface @default(CUSTOMER)
  label                String         @default("Unknown device")
  lastSeenAt           DateTime       @default(now())
  adminVerifiedAt      DateTime?
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHash           String         @unique
  refreshHash          String         @unique
  // The refresh token replaced by the latest rotation: a retry before previousRefreshUntil still
  // refreshes (the reply was lost); presenting it later revokes the session (token reuse).
  previousRefreshHash  String?        @unique
  previousRefreshUntil DateTime?
  expiresAt            DateTime
  refreshExpiresAt     DateTime
  createdAt            DateTime       @default(now())
  devices              Device[]

  @@index([userId])
}

model OtpChallenge {
  phone       String   @id
  codeHash    String
  attempts    Int      @default(0)
  sentAt      DateTime @default(now())
  expiresAt   DateTime
  consumed    Boolean  @default(false)
  windowStart DateTime @default(now())
  sends       Int      @default(1)
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  name      String
  phone     String
  line1     String
  area      String
  city      String
  state     String   @default("Bihar")
  pincode   String
  landmark  String   @default("")
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  priceRules PriceRule[]
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  priceRules     PriceRule[]
  /// The last time someone looked at this rate and said it stands.
  priceCheckedAt DateTime?
  transferLines  StockTransferLine[]
  countLines     StockCountLine[]
  // Plan 01: a heap of balu has no count, and some items are only brought in on request.
  stockMode      StockMode              @default(COUNTED)
  sourcing       Sourcing               @default(STOCKED)
  stockLevels    StockLevel[]
  aliases        ProductAlias[]
  rateItems      PriceUpdateBatchItem[]
  packSize       String                 @default("")
  minQuantity    Int                    @default(1)
  quantityStep   Int                    @default(1)
  movements      InventoryMovement[]
  id             String                 @id @default(cuid())
  name           String
  // Hindi name and description; Hindi readers see the English text while these are empty.
  nameHi         String?
  brand          String
  categoryId     String
  category       Category               @relation(fields: [categoryId], references: [id])
  type           String
  grade          String
  unit           String
  pricePaise     Int
  priceVersion   Int                    @default(1)
  version        Int                    @default(1)
  priceUpdatedAt DateTime               @default(now())
  stock          Int                    @default(0)
  lowStockAt     Int                    @default(25)
  active         Boolean                @default(true)
  images         String[]
  description    String
  descriptionHi  String?
  recommendedUse String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  priceHistory   ProductPriceHistory[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  quoteItems     QuoteItem[]

  @@index([active, categoryId])
  @@index([active, name, id])
  @@index([active, pricePaise, id])
  @@index([active, createdAt, id])
  @@index([active, categoryId, name, id])
  @@index([active, brand, name, id])
  // Trigram search indexes (pg_trgm is created by the 20261002120000_pilot_operations migration).
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_name_search")
  @@index([brand(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_brand_search")
  @@index([grade(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_grade_search")
  @@index([nameHi(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_nameHi_search")
}

model ProductPriceHistory {
  kind          String            @default("PRICE")
  batchId       String?
  batch         PriceUpdateBatch? @relation(fields: [batchId], references: [id])
  id            String            @id @default(cuid())
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  oldPricePaise Int
  newPricePaise Int
  version       Int
  actorId       String
  createdAt     DateTime          @default(now())

  @@index([productId, createdAt])
}

model CartItem {
  userId           String
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId        String
  product          Product @relation(fields: [productId], references: [id])
  quantity         Int
  seenPricePaise   Int
  seenPriceVersion Int

  @@id([userId, productId])
}

model CheckoutReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot  Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  order     Order?

  @@index([userId])
}

model Order {
  // Goes up with every change, so a tap on an old card is refused rather than confirming the wrong thing.
  version           Int                   @default(1)
  confirmedAt       DateTime?
  confirmedById     String?
  // The customer's message waits until this passes, and Wapas lo works until then.
  decisionHoldUntil DateTime?
  // A slow network's second tap repeats the same decision instead of making a new one.
  decisionKey       String?
  amendments        OrderAmendment[]
  locationId        String                @default("loc_main")
  location          Location              @relation(fields: [locationId], references: [id])
  source            OrderSource           @default(APP)
  createdById       String?
  requestHash       String?
  ledgerEntries     CustomerLedgerEntry[]
  quoteId           String?               @unique
  quote             Quote?                @relation(fields: [quoteId], references: [id])
  quoteRevision     Int?
  work              OwnerWork?
  deliveryAttempts  DeliveryAttempt[]
  id                String                @id @default(cuid())
  number            String                @unique
  userId            String
  user              User                  @relation(fields: [userId], references: [id])
  reviewId          String?               @unique
  review            CheckoutReview?       @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  idempotencyKey    String
  status            OrderStatus
  address           Json
  deliveryDate      String
  notes             String
  subtotalPaise     Int
  deliveryFeePaise  Int
  totalPaise        Int
  reservedUntil     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             OrderItem[]
  history           OrderStatusHistory[]
  payment           Payment?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, reservedUntil])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
  @@index([locationId, status, createdAt])
}

model OrderItem {
  // Which rule set this line's rate, and who changed it by hand. Old orders never move.
  ruleId          String?
  ruleKind        String?
  rateChangedById String?
  // The rate on the shop's list when this line was made. pricePaise is what is charged.
  listPricePaise Int
  packSize       String  @default("")
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  unit           String
  quantity       Int
  pricePaise     Int
  priceVersion   Int
  lineTotalPaise Int

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String
  actorId   String
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  movements               FinancialMovement[]
  id                      String              @id @default(cuid())
  orderId                 String              @unique
  order                   Order               @relation(fields: [orderId], references: [id])
  method                  PaymentMethod
  status                  PaymentStatus       @default(PENDING)
  amountPaise             Int
  razorpayOrderId         String?             @unique
  razorpayPaymentId       String?             @unique
  initializationStartedAt DateTime?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  events                  PaymentEvent[]
}

model PaymentEvent {
  id          String   @id
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])
  type        String
  payloadHash String
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

model Quote {
  locationId        String          @default("loc_main")
  location          Location        @relation(fields: [locationId], references: [id])
  deliveryConfirmed Boolean         @default(false)
  idempotencyKey    String?
  requestHash       String?
  order             Order?
  work              OwnerWork?
  decisionSource    String?
  decisionActorId   String?
  decisionAt        DateTime?
  decisionNote      String          @default("")
  id                String          @id @default(cuid())
  number            String          @unique
  userId            String
  user              User            @relation(fields: [userId], references: [id])
  status            QuoteStatus     @default(REQUESTED)
  revision          Int             @default(0)
  address           Json
  deliveryDate      String
  company           String
  gstin             String
  notes             String
  adminNote         String          @default("")
  deliveryTerms     String          @default("")
  deliveryFeePaise  Int             @default(0)
  totalPaise        Int?
  validUntil        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  items             QuoteItem[]
  revisions         QuoteRevision[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, validUntil])
  @@index([createdAt, id])
  @@index([userId, createdAt, id])
}

model QuoteItem {
  packSize       String  @default("")
  id             String  @id @default(cuid())
  quoteId        String
  quote          Quote   @relation(fields: [quoteId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  name           String
  unit           String
  quantity       Int
  unitPricePaise Int?

  @@unique([quoteId, productId])
}

model QuoteRevision {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id])
  revision  Int
  snapshot  Json
  actorId   String
  createdAt DateTime @default(now())

  @@unique([quoteId, revision])
}

model StoreSettings {
  id                     String   @id @default("store")
  phone                  String   @default("")
  deliveryFeePaise       Int      @default(50000)
  freeDeliveryAbovePaise Int?
  onlinePaymentsEnabled  Boolean  @default(false)
  deliveryMessage        String   @default("Delivery across Patna & Bihar. We will call to confirm your delivery time.")
  version                Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model Notification {
  // Held until then, so a decision can still be taken back before the customer hears of it.
  sendAfter   DateTime?
  // First time the phone showed this alert, reported by the service worker.
  deliveredAt DateTime?
  dedupeKey   String?   @unique
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  body        String
  orderId     String?
  read        Boolean   @default(false)
  sentAt      DateTime?
  pushedAt    DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId, createdAt])
}

model OwnerWork {
  id               String    @id @default(cuid())
  orderId          String?   @unique
  order            Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  quoteId          String?   @unique
  quote            Quote?    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  assignedToId     String?
  assignedTo       User?     @relation("WorkOwner", fields: [assignedToId], references: [id])
  technicalOwnerId String?
  technicalOwner   User?     @relation("TechnicalOwner", fields: [technicalOwnerId], references: [id])
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())
  deliveredAt      DateTime?
  attempts         Int       @default(0)
  nextAttemptAt    DateTime  @default(now())
  lastError        String?

  @@index([deliveredAt, nextAttemptAt])
}

model DeliveryAttempt {
  id             String   @id @default(cuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action         String
  reason         String?
  note           String
  retryDate      String?
  items          Json?
  actorId        String
  idempotencyKey String
  createdAt      DateTime @default(now())

  @@unique([orderId, idempotencyKey])
}

model FinancialMovement {
  locationId          String               @default("loc_main")
  location            Location             @relation(fields: [locationId], references: [id])
  ledgerEntry         CustomerLedgerEntry?
  id                  String               @id @default(cuid())
  paymentId           String?
  payment             Payment?             @relation(fields: [paymentId], references: [id])
  inventoryMovementId String?              @unique
  kind                String
  amountPaise         Int
  actorId             String
  occurredAt          DateTime             @default(now())
  channel             String               @default("")
  counterParty        String               @default("")

  @@unique([paymentId, kind])
  @@index([occurredAt, kind])
}

model CustomerLedgerEntry {
  locationId          String               @default("loc_main")
  location            Location             @relation(fields: [locationId], references: [id])
  id                  String               @id @default(cuid())
  customerId          String
  customer            User                 @relation(fields: [customerId], references: [id], onDelete: Restrict)
  kind                LedgerKind
  amountPaise         Int
  balanceAfterPaise   Int
  orderId             String?              @unique
  order               Order?               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  financialMovementId String?              @unique
  financialMovement   FinancialMovement?   @relation(fields: [financialMovementId], references: [id], onDelete: Restrict)
  reversesId          String?              @unique
  reverses            CustomerLedgerEntry? @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reversal            CustomerLedgerEntry? @relation("LedgerReversal")
  note                String               @default("")
  actorId             String
  occurredAt          DateTime
  createdAt           DateTime             @default(now())
  idempotencyKey      String?
  requestHash         String?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt, id])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorId    String
  body       String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt, id])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   User     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  actorId    String
  channel    String
  purpose    String
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt, id])
}

model Device {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
}

model AuditLog {
  // What the rules said when this happened, and at which shop. Append-only by trigger.
  locationId         String?
  permissionsVersion Int      @default(4)
  id                 String   @id @default(cuid())
  actorId            String
  event              String
  entityId           String
  details            Json
  createdAt          DateTime @default(now())

  @@index([entityId, createdAt])
  @@index([createdAt, id])
}

enum InventoryKind {
  PURCHASE_IN
  WALK_IN_SALE
  ONLINE_ORDER
  ORDER_CANCELLED
  RETURN
  DAMAGE
  MANUAL_ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
  OPENING_COUNT
}

model InventoryMovement {
  locationId     String        @default("loc_main")
  location       Location      @relation(fields: [locationId], references: [id])
  id             String        @id @default(cuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  kind           InventoryKind
  quantity       Int
  balanceAfter   Int
  actorId        String
  reference      String
  note           String
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())

  @@index([productId, createdAt, id])
  @@index([createdAt, id])
}

model DeliveryZone {
  rates                  DeliveryRate[]
  locationId             String            @default("loc_main")
  location               Location          @relation(fields: [locationId], references: [id])
  id                     String            @id @default(cuid())
  name                   String
  active                 Boolean           @default(true)
  deliveryFeePaise       Int
  minimumOrderPaise      Int               @default(0)
  freeDeliveryAbovePaise Int?
  estimate               String
  terms                  String            @default("")
  version                Int               @default(1)
  pincodes               DeliveryPincode[]
}

model DeliveryPincode {
  pincode String       @id
  zoneId  String
  zone    DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
}

model AdminCredential {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model AuthRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ProductAlias {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  alias           String
  normalizedAlias String   @unique
  source          String
  confirmedBy     String
  createdAt       DateTime @default(now())

  @@index([productId])
}

model RateSource {
  id          String             @id @default(cuid())
  sha256      String             @unique
  fileName    String
  contentType String
  size        Int
  storageKey  String
  createdBy   String
  createdAt   DateTime           @default(now())
  ocrText     String?
  ocr         Json?
  batches     PriceUpdateBatch[]
}

model PriceUpdateBatch {
  id             String                 @id @default(cuid())
  title          String
  sourceType     String
  status         String                 @default("DRAFT")
  version        Int                    @default(1)
  idempotencyKey String                 @unique
  sourceId       String?
  source         RateSource?            @relation(fields: [sourceId], references: [id])
  createdBy      String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  publishedBy    String?
  publishedAt    DateTime?
  stage          String                 @default("")
  attemptToken   String?
  leaseUntil     DateTime?
  attempts       Int                    @default(0)
  errorCode      String?
  extraction     Json?
  usage          Json                   @default("{}")
  items          PriceUpdateBatchItem[]
  cards          RateCard[]
  history        ProductPriceHistory[]

  @@index([createdAt, id])
  @@index([status, leaseUntil])
}

model PriceUpdateBatchItem {
  id                     String           @id @default(cuid())
  batchId                String
  batch                  PriceUpdateBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  position               Int
  productId              String?
  product                Product?         @relation(fields: [productId], references: [id])
  label                  String           @default("")
  brand                  String           @default("")
  specification          String           @default("")
  unit                   String           @default("")
  weight                 String           @default("")
  proposedPricePaise     Int?
  oldPricePaise          Int?
  expectedProductVersion Int?
  included               Boolean          @default(true)
  reviewed               Boolean          @default(false)
  acknowledged           Boolean          @default(false)
  rememberAlias          Boolean          @default(false)
  note                   String           @default("")
  confidence             Float?
  matchMethod            String           @default("MANUAL")
  extracted              Json?
  publishedPricePaise    Int?
  publishedProduct       Json?

  @@unique([batchId, position])
  @@index([productId])
}

model RateCard {
  id        String           @id @default(cuid())
  batchId   String
  batch     PriceUpdateBatch @relation(fields: [batchId], references: [id])
  format    String
  template  String
  snapshot  Json
  createdBy String
  createdAt DateTime         @default(now())

  @@index([batchId, createdAt])
}

model DemandOverride {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  kind          String
  maxTotalPaise Int
  expiresAt     DateTime
  usedAt        DateTime?

  @@index([userId, kind, expiresAt])
}

model ProductAsset {
  id        String   @id
  url       String   @unique
  createdAt DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model OutboundMessage {
  id            String    @id @default(cuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  channel       String
  recipient     String
  template      String
  params        Json
  dedupeKey     String    @unique
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  providerId    String?
  createdAt     DateTime  @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}

enum EnquiryStatus {
  NEW
  HANDLED
}

/// A question from the website's Contact page. Deleted by maintenance: handled ones after
/// 180 days, unanswered ones after a year (the privacy page states both).
model WebEnquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  pincode     String?
  interest    String?
  message     String
  language    String        @default("hi")
  status      EnquiryStatus @default(NEW)
  handledAt   DateTime?
  handledById String?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

enum StockMode {
  COUNTED
  AVAILABILITY
}

enum Sourcing {
  STOCKED
  ON_REQUEST
}

enum SessionSurface {
  CUSTOMER
  DESK
  STAFF_APP
}

enum StaffRole {
  OWNER
  MANAGER
  CASHIER
  ACCOUNTANT
  STOCK_KEEPER
  DRIVER
  HELPER
  TECH_OPERATOR
}

/// One row today. It gives the shop's legal identity a home, and saves a retrofit if shops split.
model Firm {
  id                    String     @id @default(cuid())
  legalName             String
  tradeName             String     @default("")
  gstin                 String?
  complaintOfficerName  String     @default("")
  complaintOfficerPhone String     @default("")
  approvedAt            DateTime?
  createdAt             DateTime   @default(now())
  locations             Location[]
}

model Location {
  /// How far below list a manager here may set a rate at confirm. Set by owners; 0 means not at all.
  managerRateCapPercent Int                   @default(0)
  id                    String                @id @default(cuid())
  firmId                String
  firm                  Firm                  @relation(fields: [firmId], references: [id])
  slug                  String                @unique
  name                  String
  active                Boolean               @default(true)
  /// When this shop's count began. A shop added from the desk counts from nothing, at once.
  stockStartedAt        DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  stockLevels           StockLevel[]
  memberships           StaffMembership[]
  inventoryMovements    InventoryMovement[]
  orders                Order[]
  quotes                Quote[]
  deliveryZones         DeliveryZone[]
  financialMovements    FinancialMovement[]
  customerLedgerEntries CustomerLedgerEntry[]
  transfersOut          StockTransfer[]       @relation("TransferFrom")
  transfersIn           StockTransfer[]       @relation("TransferTo")
  stockCounts           StockCount[]
  dayCloses             DayClose[]
  gallaEntries          GallaEntry[]
}

/// Per-shop stock. Product.stock stays the all-shops total until every client reads availability.
model StockLevel {
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location  @relation(fields: [locationId], references: [id])
  quantity   Int       @default(0)
  lowStockAt Int       @default(25)
  /// AVAILABILITY items are switched on and off, not counted.
  isOn       Boolean   @default(true)
  countedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  @@id([productId, locationId])
  @@index([locationId, quantity])
}

/// Who holds which role at which shop. Never deleted: ending access only sets endedAt.
model StaffMembership {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation("MemberUser", fields: [userId], references: [id])
  /// Null means all shops, and only all-shop roles may have it.
  locationId  String?
  location    Location? @relation(fields: [locationId], references: [id])
  role        StaffRole
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  grantedById String
  endedById   String?

  @@index([userId, endedAt])
  @@index([locationId, role, endedAt])
}

/// Lets a notification's buttons work with the desk closed. Single use, short lived, one person.
model PushActionToken {
  // Which order, and which version of it, this person was shown.
  orderId        String?
  orderVersion   Int?
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  purpose        String
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

model WorkerHeartbeat {
  lane      String    @id
  lastRunAt DateTime
  lastOkAt  DateTime?
  lastStep  String    @default("")
}

/// What changed on an order when someone confirmed it with changes. Never changed or deleted.
model OrderAmendment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  version   Int
  actorId   String
  /// The order before and after, enough to put it back exactly on Wapas lo.
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@unique([orderId, version])
}

// Silent reading of the shop's WhatsApp (master plan Phase 2, Track A). Nothing here can send.
model WaThread {
  id            String        @id @default(cuid())
  // The phone when known, else WhatsApp's business-scoped id for someone hiding their number.
  contactKey    String        @unique
  phone         String?       @unique
  bsuid         String?       @unique
  // Set by the sender, so never trusted and never shown on a lock screen.
  profileName   String        @default("")
  savedName     String        @default("")
  userId        String?
  aiMode        String        @default("AUTO")
  humanUntil    DateTime?
  lastInboundAt DateTime?
  lastEchoAt    DateTime?
  nextRunAt     DateTime?
  leaseUntil    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      WaMessage[]
  runs          WaReaderRun[]

  @@index([nextRunAt])
  @@index([lastEchoAt])
}

model WaMessage {
  id         String    @id @default(cuid())
  wamid      String    @unique
  threadId   String
  thread     WaThread  @relation(fields: [threadId], references: [id])
  direction  String
  type       String
  // Null for AI-off numbers, gated messages, voice and photos, and after the retention period.
  text       String?
  truncated  Boolean   @default(false)
  state      String    @default("RECEIVED")
  sentAt     DateTime
  receivedAt DateTime  @default(now())
  editedAt   DateTime?
  revokedAt  DateTime?
  purgedAt   DateTime?

  @@index([threadId, sentAt])
  @@index([state, threadId])
  @@index([receivedAt])
}

model WaReaderRun {
  id            String    @id @default(cuid())
  threadId      String
  thread        WaThread  @relation(fields: [threadId], references: [id])
  messageIds    String[]
  reader        String
  promptVersion String    @default("")
  inputTokens   Int       @default(0)
  outputTokens  Int       @default(0)
  costMicroUsd  Int       @default(0)
  latencyMs     Int       @default(0)
  // Holds the customer's words as evidence, so it is cleared with the message text.
  output        Json?
  intent        String?
  band          String?
  wouldReply    String?
  errorCode     String?
  review        String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([threadId, createdAt])
  @@index([review, createdAt])
  @@index([createdAt])
}

model WaSettings {
  id            String    @id @default("wa")
  aiPaused      Boolean   @default(false)
  pausedById    String?
  pausedAt      DateTime?
  lastWebhookAt DateTime?
  lastAccount   String    @default("")
  updatedAt     DateTime  @updatedAt
}

// Shop operations (master plan Phase 4). Goods on the road belong to neither shop until counted in.
enum TransferStatus {
  SENT
  RECEIVED
  DIFFERENT
  SETTLED
}

enum CountStatus {
  OPEN
  SUBMITTED
  APPROVED
  RECOUNT
}

model StockTransfer {
  id             String              @id @default(cuid())
  fromLocationId String
  from           Location            @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  to             Location            @relation("TransferTo", fields: [toLocationId], references: [id])
  status         TransferStatus      @default(SENT)
  vehicle        String              @default("")
  carrierName    String              @default("")
  note           String              @default("")
  sentById       String
  sentAt         DateTime            @default(now())
  receivedById   String?
  receivedAt     DateTime?
  idempotencyKey String              @unique
  lines          StockTransferLine[]

  @@index([status, toLocationId])
  @@index([fromLocationId, sentAt])
}

model StockTransferLine {
  transferId  String
  transfer    StockTransfer @relation(fields: [transferId], references: [id])
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  sentQty     Int
  receivedQty Int?

  @@id([transferId, productId])
}

/// A blind count. System figures appear only after submit, and only to those who decide.
model StockCount {
  id          String           @id @default(cuid())
  locationId  String
  location    Location         @relation(fields: [locationId], references: [id])
  status      CountStatus      @default(OPEN)
  opening     Boolean          @default(false)
  startedById String
  countedById String?
  submittedAt DateTime?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime         @default(now())
  lines       StockCountLine[]

  @@index([locationId, createdAt])
}

model StockCountLine {
  countId       String
  count         StockCount @relation(fields: [countId], references: [id])
  productId     String
  product       Product    @relation(fields: [productId], references: [id])
  countedQty    Int?
  systemQty     Int?
  heldQty       Int?
  differenceQty Int?

  @@id([countId, productId])
}

/// Manzoori: what someone asked and only an owner may decide. The asker can never approve.
model ApprovalRequest {
  id             String    @id @default(cuid())
  kind           String
  status         String    @default("PENDING")
  locationId     String?
  amountPaise    Int?
  payload        Json
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  note           String    @default("")
  decisionNote   String    @default("")
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  @@index([status, locationId, createdAt])
  @@index([requestedById, createdAt])
}

/// Galla: how a shop's cash drawer ended the day. Append-only: a correction supersedes the old row.
model DayClose {
  id              String   @id @default(cuid())
  locationId      String
  location        Location @relation(fields: [locationId], references: [id])
  day             String
  expectedPaise   Int
  countedPaise    Int
  differencePaise Int
  reason          String   @default("")
  closedById      String
  supersedesId    String?  @unique
  createdAt       DateTime @default(now())

  @@index([locationId, day])
}

/// Money put into or taken out of the drawer by hand, with why.
model GallaEntry {
  id             String   @id @default(cuid())
  locationId     String
  location       Location @relation(fields: [locationId], references: [id])
  day            String
  kind           String
  amountPaise    Int
  reason         String
  actorId        String
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  @@index([locationId, day])
}

// Daam aur offer (master plan Phase 4, plan 13 section 3).
model CustomerGroup {
  id          String      @id @default(cuid())
  name        String      @unique
  active      Boolean     @default(true)
  createdById String
  createdAt   DateTime    @default(now())
  customers   User[]
  rules       PriceRule[]
}

model PriceRule {
  id          String         @id @default(cuid())
  kind        String
  title       String         @default("")
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id])
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  minQuantity Int            @default(1)
  groupId     String?
  group       CustomerGroup? @relation(fields: [groupId], references: [id])
  customerId  String?
  valueType   String
  value       Int
  startsOn    String?
  endsOn      String?
  active      Boolean        @default(true)
  stacks      Boolean        @default(false)
  isPublic    Boolean        @default(false)
  createdById String
  version     Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([active, kind])
  @@index([customerId])
}

model DeliveryRate {
  id        String       @id @default(cuid())
  zoneId    String
  zone      DeliveryZone @relation(fields: [zoneId], references: [id])
  vehicle   String
  feePaise  Int
  active    Boolean      @default(true)
  updatedAt DateTime     @updatedAt

  @@unique([zoneId, vehicle])
}
