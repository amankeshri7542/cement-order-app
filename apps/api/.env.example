# Required (development, test or production): the API refuses to start without it.
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://shiv:local-development-only@localhost:5432/shiv_cement
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
OTP_PROVIDER=mock
OTP_HASH_SECRET=change-me-to-a-random-secret-at-least-32-characters
# Real OTP: set OTP_PROVIDER=twilio and configure Twilio Verify for India.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://assets.example.com
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Rate Studio: backend-only credentials; manual workflows need none of these.
# GOOGLE_VISION_API_KEY=replace-with-restricted-vision-key
# OPENAI_API_KEY=replace-with-project-key
# RATE_OPENAI_MODEL=replace-with-verified-structured-output-model-id
# RATE_SOURCE_BUCKET=private-rate-sources

# Public Shiv Assistant: catalogue/approved FAQ fallback works without a provider.
ASSISTANT_PROVIDER=fallback
ASSISTANT_REQUESTS_PER_HOUR=30
ASSISTANT_REQUESTS_PER_DAY=500
ASSISTANT_DAILY_BUDGET_MICRO_USD=1000000
# Live mode requires separately approved credentials/model and current provider prices.
# ASSISTANT_OPENAI_API_KEY=replace-with-dedicated-project-key
# ASSISTANT_MODEL=replace-with-verified-model-id
# Prices are integer microUSD per one million tokens; confirm both before enabling.
# ASSISTANT_INPUT_MICRO_USD_PER_MILLION=
# ASSISTANT_OUTPUT_MICRO_USD_PER_MILLION=
# ASSISTANT_PROVIDER=simulation is only for labelled non-production tests.

# Android app updates: installs below the minimum are asked to update before ordering
# (GET /client-config). Raise the minimum only after the new version is live on Google Play;
# the API refuses to start with a minimum above the latest version.
# ANDROID_MINIMUM_VERSION=1.0.0
# ANDROID_LATEST_VERSION=1.0.0
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=in.shivcement.store

# Open public live-update streams (GET /events) per client IP and in total; extra ones get 429.
# EVENT_STREAMS_PER_IP=20
# EVENT_STREAMS_TOTAL=2000

# Owner alerts. WhatsApp stays on the fake provider (logs only, nothing is sent) until Meta
# approves the business number and the templates listed in apps/api/src/alerts.ts.
# WHATSAPP_PROVIDER=fake
# WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
# WHATSAPP_TEMPLATE_LANGUAGE=hi
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_DAILY_LIMIT=200
# WHATSAPP_CUSTOMER_UPDATES=false
# Owner desk alerts on phones and computers: generate once with `npx web-push generate-vapid-keys`.
# WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
# WEB_PUSH_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
# WEB_PUSH_SUBJECT=mailto:REPLACE_WITH_OWNER_EMAIL
