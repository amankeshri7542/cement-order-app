# Required (development, test or production): the API refuses to start without it.
NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
DATABASE_URL=postgresql://shiv:local-development-only@localhost:5432/shiv_cement
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
OTP_PROVIDER=mock
OTP_HASH_SECRET=change-me-to-a-random-secret-at-least-32-characters
# Signs the hazri QR codes and seals staff screen secrets. Different from OTP_HASH_SECRET in production.
# STAFF_SECRET=change-me-to-another-random-secret-at-least-32-characters
# Real OTP: set OTP_PROVIDER=twilio and configure Twilio Verify for India.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://assets.example.com
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Rate Studio: backend-only credentials; manual workflows need none of these.
# GOOGLE_VISION_API_KEY=replace-with-restricted-vision-key
# OPENAI_API_KEY=replace-with-project-key
# RATE_OPENAI_MODEL=replace-with-verified-structured-output-model-id
# RATE_SOURCE_BUCKET=private-rate-sources

# Ask, the AI advisor. Off by default: fixed text, rate cards and the signed guide work with no key.
# It reaches a model only when ASK_ENABLED=true, a real provider and key are set, an owner has not
# paused it, articles are signed, and content/advisor/eval-report.json matches what is running.
# ASK_ENABLED=false
ADVISOR_PROVIDER=fallback
# Its own key, in a workspace with its own spend limit. simulation is for tests and local screens.
# ADVISOR_ANTHROPIC_API_KEY=replace-with-dedicated-workspace-key
# ADVISOR_MODEL_TRIAGE=claude-haiku-5-5
# ADVISOR_MODEL_ANSWER=claude-haiku-5-5
# Micro dollars per million tokens. Confirm against the provider's price page before turning on.
# ADVISOR_INPUT_MICRO_USD_PER_MILLION=100000
# ADVISOR_OUTPUT_MICRO_USD_PER_MILLION=500000
# ADVISOR_CACHE_WRITE_MICRO_USD_PER_MILLION=125000
# ADVISOR_CACHE_READ_MICRO_USD_PER_MILLION=10000
# Rupees 10 a day and rupees 300 a month, at 95 to the dollar.
# ADVISOR_DAILY_BUDGET_MICRO_USD=105263
# ADVISOR_MONTHLY_BUDGET_MICRO_USD=3157894
# ADVISOR_QUESTIONS_PER_DEVICE_DAY=5
# ADVISOR_QUESTIONS_PER_ACCOUNT_DAY=10
# ADVISOR_QUESTIONS_PER_IP_DAY=20
# ADVISOR_TURNS_PER_IP_HOUR=120
# ADVISOR_TURNS_PER_DEVICE_DAY=60
# ADVISOR_TURNS_PER_DAY=1500
# ADVISOR_TURNS_PER_CONVERSATION=16
# ADVISOR_DEVICES_PER_IP_DAY=30
# ADVISOR_CONCURRENCY=8

# Android app updates: installs below the minimum are asked to update before ordering
# (GET /client-config). Raise the minimum only after the new version is live on Google Play;
# the API refuses to start with a minimum above the latest version.
# The website's awards page, once real certificates are up.
# AWARDS_URL=https://www.example.invalid/awards
# ANDROID_MINIMUM_VERSION=1.0.0
# ANDROID_LATEST_VERSION=1.0.0
# ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=in.shivcement.store

# Open public live-update streams (GET /events) per client IP and in total; extra ones get 429.
# EVENT_STREAMS_PER_IP=20
# EVENT_STREAMS_TOTAL=2000

# Owner alerts. WhatsApp stays on the fake provider (logs only, nothing is sent) until Meta
# approves the business number and the templates listed in apps/api/src/alerts.ts.
# WHATSAPP_PROVIDER=fake
# WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_META_SYSTEM_USER_TOKEN
# WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_PHONE_NUMBER_ID
# WHATSAPP_TEMPLATE_LANGUAGE=hi
# WHATSAPP_API_VERSION=v23.0
# WHATSAPP_DAILY_LIMIT=200
# WHATSAPP_CUSTOMER_UPDATES=false
# The shop's WhatsApp: off, shadow (reads, sends nothing) or reply. See docs/WHATSAPP_CONNECT.md.
# WA_MODE=off
# Replies also need an owner to move the stage up on the desk, past the readiness check.
# WA_REPLY_PROVIDER=off
# WA_REPLY_API_KEY=REPLACE_WITH_PARTNER_API_KEY
# WA_PRIVACY_URL=https://example.invalid/privacy
# WA_SECOND_NUMBER=+910000000000
# WA_APPEAL_ROUTE=REPLACE_WITH_PARTNER_APPEAL_ROUTE
# WA_TEMPLATES_APPROVED=false
# WA_REPLY_TEMPLATE_LANGUAGE=en_IN
# WA_REPLIES_PER_THREAD_HOUR=3
# WA_REPLIES_PER_THREAD_DAY=8
# WA_REPLY_MAX_AGE_MINUTES=30
# WA_THREAD_MESSAGES_PER_HOUR=60
# WA_PASTES_PER_HOUR=60
# WA_WEBHOOK_PROVIDER=ycloud
# WA_PARTNER_NAME=REPLACE_WITH_PARTNER_NAME
# WA_BUSINESS_PHONE=+910000000000
# WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
# WHATSAPP_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
# WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_LONG_RANDOM_TOKEN
# WA_READER_PROVIDER=off
# WA_READER_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=REPLACE_WITH_PAID_GEMINI_KEY
# WA_READER_PAID_KEY=false
# WA_READER_INPUT_MICRO_USD_PER_MILLION=250000
# WA_READER_OUTPUT_MICRO_USD_PER_MILLION=1500000
# WA_READER_MONTHLY_BUDGET_MICRO_USD=5200000
# WA_READER_CALLS_PER_THREAD_HOUR=12
# WA_READER_CALLS_PER_THREAD_DAY=40
# WA_BURST_WAIT_SECONDS=8
# WA_TEXT_RETENTION_DAYS=30
# WA_BIG_ORDER_PAISE=15000000
# Owner desk alerts on phones and computers: generate once with `npx web-push generate-vapid-keys`.
# WEB_PUSH_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
# WEB_PUSH_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
# WEB_PUSH_SUBJECT=mailto:REPLACE_WITH_OWNER_EMAIL
# Only this authenticated ADMIN may override a customer credit limit. Blank disables overrides.
CREDIT_OVERRIDE_PHONE=
# Owner OTP-only sign-in and sliding device sessions; true restores 8-hour passphrase sessions.
STAFF_PASSPHRASE_REQUIRED=false
OWNER_SESSION_DAYS=30
# Which work this process does: all (one process), web (requests only) or worker (background only).
SHIV_ROLE=all
# Required with DEMO_MODE: the one database host a demo may run against.
# DEMO_DATABASE_HOST=
# Hosted fake-data demo only: allows mock OTP in production behind a proxy. Never with real data.
# DEMO_MODE=false
# Six-digit staff sign-in code for DEMO_MODE; staff codes are never shown on screen.
# DEMO_STAFF_CODE=

# Public website.
# "on" once the family says the listed rates are real. Until then every rate is tagged as a sample
# and no page is indexed by search engines.
# PUBLIC_RATES_REAL=off
# A list line worth more than this goes to "Ask for a rate" instead of Place order (paise).
# ONLINE_LINE_LIMIT_PAISE=50000000
# How many list checks one network address may ask for in a minute.
# LIST_CHECK_PER_IP_MINUTE=120
# Tells the website its cached catalogue is out of date. Both must be set, or nothing is sent.
# STOREFRONT_REVALIDATE_URL=https://www.example.in/api/revalidate
# REVALIDATE_SECRET=
