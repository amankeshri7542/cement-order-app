# Staging API template. Placeholders only: never commit filled-in values.
# Copy into the hosting provider's secret settings, not into a file in the repository.
# Staging runs NODE_ENV=production so it exercises every production startup guard.
# See docs/STAGING_RUNBOOK.md.
NODE_ENV=production
PORT=4000
# 1 only when exactly one trusted reverse proxy sits in front of the API; 0 otherwise.
TRUST_PROXY_HOPS=1
# Restricted runtime role (no CREATE/ownership). Migrations use a separate role in the release job.
# connection_limit keeps one API instance within the database plan's connection budget.
DATABASE_URL=postgresql://REPLACE_RUNTIME_USER:REPLACE_RUNTIME_PASSWORD@REPLACE_STAGING_DB_HOST:5432/REPLACE_STAGING_DB?sslmode=require&connection_limit=5&pool_timeout=10
# Exact HTTPS origins of the staging storefront, owner desk and customer web app.
CORS_ORIGINS=https://shop.staging.example.com,https://admin.staging.example.com,https://app.staging.example.com
# Real OTP is mandatory under NODE_ENV=production; mock OTP is refused at startup.
OTP_PROVIDER=twilio
# At least 32 random characters, unique to staging (e.g. `openssl rand -base64 48`).
OTP_HASH_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_FOR_STAGING_ONLY
TWILIO_ACCOUNT_SID=REPLACE_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=REPLACE_TWILIO_AUTH_TOKEN
TWILIO_VERIFY_SERVICE_SID=REPLACE_TWILIO_VERIFY_SERVICE_SID
# Approved catalogue/FAQ answers only; no provider key needed.
ASSISTANT_PROVIDER=fallback
ASSISTANT_REQUESTS_PER_HOUR=30
ASSISTANT_REQUESTS_PER_DAY=500
ASSISTANT_DAILY_BUDGET_MICRO_USD=1000000
# Set by the release job to the deployed commit; appears in startup logs.
RELEASE_SHA=REPLACE_WITH_DEPLOYED_COMMIT_SHA
# Leave unset in staging: online payments stay disabled.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Optional product-image storage; leave unset until a separate asset origin is approved.
# R2_ENDPOINT=https://REPLACE_ACCOUNT.r2.cloudflarestorage.com
# R2_BUCKET=REPLACE_STAGING_BUCKET
# R2_ACCESS_KEY_ID=REPLACE
# R2_SECRET_ACCESS_KEY=REPLACE
# R2_PUBLIC_URL=https://assets.staging.example.com
