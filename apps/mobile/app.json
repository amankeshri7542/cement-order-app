{
  "expo": {
    "name": "Shiv Cement",
    "slug": "shiv-cement-store",
    "scheme": "shivcement",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.shivcement.store",
      "supportsTablet": true
    },
    "android": {
      "package": "in.shivcement.store",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#121513"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Shiv Cement"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAE7DE",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      "expo-image",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shiv Cement uses your location only when you tap \"I am at the site\", to save that spot for the delivery driver.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Release builds print no debug, verbose or info lines: the SMS reader library logs each message it\n# receives, and a sign-in code must not be left in the phone's log.\n-assumenosideeffects class android.util.Log {\n public static int v(...);\n public static int d(...);\n public static int i(...);\n}\n"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#EAE7DE"
  }
}
